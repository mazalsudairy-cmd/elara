## ElaraBase — environment variables
## Copy this file to `.env.local` and fill in real values.
## Never commit `.env.local` or any file containing real secrets.

# Public site URL (used for canonical URLs, OG tags, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Phase 1) ---
# Postgres connection string. Use a managed service in production
# (Neon, Supabase, RDS, etc.) with TLS enforced.
DATABASE_URL=postgresql://elara:elara@localhost:5432/elarabase

# --- Auth (Phase 1) ---
# 32+ byte random string used to sign session cookies. Rotate carefully.
AUTH_SECRET=replace-with-openssl-rand-base64-48
# Optional: where to redirect after a successful login.
AUTH_DEFAULT_REDIRECT=/ar

# --- Mail / transactional email ---
# Provider: Resend / Postmark / SES. Provide what your code expects.
MAIL_FROM="ElaraBase <noreply@elarabase.com>"
RESEND_API_KEY=

# --- Object storage / images ---
# Used for product photos uploaded via the admin.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Payments ---
# Saudi-friendly options: Tap, Moyasar, HyperPay, or Stripe (with mada).
PAYMENT_PROVIDER=moyasar
MOYASAR_API_KEY=

# --- Future OTP integration (Phase 3) ---
# Reserved keys — leave blank for Phase 1.
OTP_PROVIDER=
OTP_API_KEY=
